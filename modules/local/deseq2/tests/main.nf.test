nextflow_process {

    name "Test Process DESEQ2"
    script "../main.nf"
    process "DESEQ2"
    config "./nextflow.config"

    test("deseq2 - yeast WT vs RAP1 counts") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file("\${projectDir}/modules/local/deseq2/tests/test_counts.tsv", checkIfExists: true)
                ]
                input[1] = file("\${projectDir}/modules/local/deseq2/tests/test_samplesheet.csv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.results[0][1]).exists() },
                { assert path(process.out.report[0][1]).exists() },
                { assert path(process.out.pca[0][1]).exists() },
                { assert path(process.out.volcano[0][1]).exists() },
                { assert snapshot(
                    process.out.results,
                    process.out.versions
                ).match() }
            )
        }
    }
}
