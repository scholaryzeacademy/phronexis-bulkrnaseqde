/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run phronexis/bulkrnaseqde -profile test,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data (custom samplesheet with a condition column for downstream DE)
    input             = "${projectDir}/assets/samplesheet_test.csv"

    // Reference: Salmon pseudo-alignment path (transcriptome + GTF, no genome key)
    transcript_fasta  = 'https://github.com/nf-core/test-datasets/raw/rnaseq/reference/transcriptome.fasta'
    gtf               = 'https://github.com/nf-core/test-datasets/raw/rnaseq/reference/genes.gtf.gz'
}
